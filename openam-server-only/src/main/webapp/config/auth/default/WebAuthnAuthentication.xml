<!DOCTYPE ModuleProperties PUBLIC "=//iPlanet//Authentication Module Properties XML Interface 1.0 DTD//EN"
        "jar://com/sun/identity/authentication/Auth_Module_Properties.dtd">
<ModuleProperties moduleName="WebAuthnAuthentication" version="1.0" >
    <Callbacks length="0" order="1">
    </Callbacks>
    <Callbacks length="2" order="2" header="First, enter your username">
        <NameCallback>
            <Prompt>Username</Prompt>
        </NameCallback>
        <ConfirmationCallback>
            <OptionValues>
                <OptionValue>
                    <Value>Continue</Value>
                </OptionValue>
            </OptionValues>
        </ConfirmationCallback>
    </Callbacks>
	    <Callbacks length="3" order="3" header="Use your passkey">
	        <HiddenValueCallback>
	            <Id>clientScriptOutputData</Id>
	        </HiddenValueCallback>
	        <TextOutputCallback messageType="script">PLACEHOLDER</TextOutputCallback>
	        <ConfirmationCallback>
	            <OptionValues>
	                <OptionValue>
	                    <Value>Continue</Value>
	                </OptionValue>
	                <OptionValue>
	                    <Value>Cancel</Value>
	                </OptionValue>
	                <OptionValue>
	                    <Value>Use a recovery code</Value>
	                </OptionValue>
	            </OptionValues>
	        </ConfirmationCallback>
	    </Callbacks>
	    <Callbacks length="2" order="4" timeout="120" header="Use a recovery code">
	        <NameCallback>
	            <Prompt>Recovery code</Prompt>
	        </NameCallback>
	        <ConfirmationCallback>
	            <OptionValues>
	                <OptionValue>
	                    <Value>Continue</Value>
	                </OptionValue>
	            </OptionValues>
	        </ConfirmationCallback>
	    </Callbacks>
	    <Callbacks length="2" order="5" timeout="120" header="Recovery code used">
	        <TextOutputCallback>
	            That code can't be used again. Use one of your remaining recovery codes next time.
	        </TextOutputCallback>
	        <ConfirmationCallback>
	            <OptionValues>
	                <OptionValue>
	                    <Value>Continue</Value>
	                </OptionValue>
	            </OptionValues>
	        </ConfirmationCallback>
	    </Callbacks>
	    <Callbacks length="3" order="6" timeout="120" header="Use a recovery code">
	        <TextOutputCallback messageType="error">
	            The recovery code isn't valid. Check the code and try again.
	        </TextOutputCallback>
	        <NameCallback>
	            <Prompt>Recovery code</Prompt>
	        </NameCallback>
	        <ConfirmationCallback>
	            <OptionValues>
	                <OptionValue>
	                    <Value>Continue</Value>
	                </OptionValue>
	            </OptionValues>
	        </ConfirmationCallback>
	    </Callbacks>
	</ModuleProperties>
